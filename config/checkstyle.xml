<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="https?://"/>
    </module>
    <module name="FileLength">
        <property name="max" value="400"/>
    </module>
    <module name="TreeWalker">
        <module name="MethodLength">
            <property name="max" value="20"/>
            <property name="countEmpty" value="false"/>
            <property name="tokens" value="METHOD_DEF,CTOR_DEF,COMPACT_CTOR_DEF"/>
        </module>
        <module name="OneStatementPerLine"/>
        <module name="NeedBraces">
            <property name="tokens" value="LITERAL_FOR,LITERAL_WHILE,LITERAL_DO"/>
        </module>
        <module name="ExecutableStatementCount">
            <property name="max" value="15"/>
        </module>
        <module name="CyclomaticComplexity">
            <property name="max" value="8"/>
        </module>
        <module name="NPathComplexity">
            <property name="max" value="80"/>
        </module>
        <module name="NestedForDepth">
            <property name="max" value="2"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="2"/>
        </module>
        <module name="JavaNCSS">
            <property name="classMaximum" value="200"/>
        </module>
    </module>
</module>
