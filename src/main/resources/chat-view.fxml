<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.kirstenali.deepj.chatui.ChatTranscript?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
            fx:controller="io.github.kirstenali.deepj.chatui.ChatController"
            styleClass="app-root,theme-light">
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" spacing="18">
            <HBox styleClass="brand-row" spacing="12" alignment="CENTER_LEFT">
                <Label text="D" styleClass="brand-icon"/>
                <VBox spacing="2">
                    <Label text="DeepJ" styleClass="brand-title"/>
                    <Label text="Local model chat" styleClass="muted"/>
                </VBox>
            </HBox>
            <Button text="＋  New chat" onAction="#onNewChat" styleClass="sidebar-button" maxWidth="Infinity"/>
            <VBox styleClass="model-card" spacing="8">
                <Label text="MODEL" styleClass="eyebrow"/>
                <Label fx:id="modelNameLabel" text="No model loaded" styleClass="model-name" wrapText="true"/>
                <Button fx:id="modelButton" text="Choose file" onAction="#onBrowseModel"
                        styleClass="quiet-button"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox fx:id="settingsPane" spacing="7" styleClass="settings-pane" visible="false" managed="false">
                <Label text="GENERATION" styleClass="eyebrow"/>
                <Label text="Temperature" styleClass="field-label"/>
                <TextField fx:id="temperatureField" styleClass="settings-field"/>
                <Label text="Top-k" styleClass="field-label"/>
                <TextField fx:id="topKField" styleClass="settings-field"/>
                <Label text="Maximum new tokens" styleClass="field-label"/>
                <TextField fx:id="maxTokensField" styleClass="settings-field"/>
                <Label text="Seed" styleClass="field-label"/>
                <TextField fx:id="seedField" styleClass="settings-field"/>
            </VBox>
            <Button text="⚙  Generation settings" onAction="#onToggleSettings"
                    styleClass="sidebar-button" maxWidth="Infinity"/>
            <Label fx:id="statusLabel" text="Choose a model to begin" styleClass="muted" wrapText="true"/>
        </VBox>
    </left>
    <center>
        <BorderPane styleClass="main-panel">
            <top>
                <HBox styleClass="top-bar" spacing="16" alignment="CENTER_LEFT">
                    <Button fx:id="sidebarButton" text="☰" onAction="#onToggleSidebar"
                            styleClass="icon-button" accessibleText="Toggle sidebar"/>
                    <VBox spacing="2">
                        <Label text="DeepJ Chat" styleClass="header-title"/>
                        <Label text="Private and on-device" styleClass="muted"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="themeSelector" promptText="Theme" styleClass="theme-picker"/>
                </HBox>
            </top>
            <center>
                <ChatTranscript fx:id="transcript"/>
            </center>
            <bottom>
                <VBox styleClass="composer-wrap" alignment="CENTER" spacing="7">
                    <HBox styleClass="composer" alignment="CENTER_LEFT" spacing="10" maxWidth="880">
                        <TextArea fx:id="inputArea" promptText="Message DeepJ" wrapText="true"
                                  prefRowCount="2" maxHeight="120" onKeyPressed="#onInputKeyPressed"
                                  styleClass="chat-input" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="sendButton" text="➜" onAction="#onSend"
                                styleClass="send-button" accessibleText="Send message"/>
                    </HBox>
                    <Label text="Enter to send · Shift+Enter for a new line" styleClass="hint"/>
                </VBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
