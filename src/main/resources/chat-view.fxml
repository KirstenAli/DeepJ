<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="rootPane"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="io.github.kirstenali.deepj.chatui.ChatController"
            styleClass="app-root, theme-light">
    <left>
        <VBox fx:id="sidebarPane" id="sidebarPane" styleClass="sidebar" spacing="16">
            <padding>
                <Insets top="20" right="16" bottom="18" left="16"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="brand-row">
                <Label text="D" styleClass="brand-mark"/>
                <VBox spacing="1">
                    <Label text="DeepJ" styleClass="brand-title"/>
                    <Label text="Local model chat" styleClass="brand-caption"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button accessibleText="Hide sidebar"
                        onAction="#onToggleSidebar"
                        styleClass="sidebar-toggle-button">
                    <graphic>
                        <SVGPath content="M2 3h14v12H2z M6 3v12"
                                 styleClass="button-icon"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Hide sidebar"/>
                    </tooltip>
                </Button>
            </HBox>

            <Button fx:id="newChatButton"
                    text="New chat"
                    maxWidth="Infinity"
                    onAction="#onNewChat"
                    styleClass="new-chat-button">
                <graphic>
                    <SVGPath content="M3 12.5V16h3.5L16 6.5 12.5 3 3 12.5z M11.5 4l3.5 3.5"
                             styleClass="button-icon"/>
                </graphic>
            </Button>

            <VBox spacing="8">
                <Label text="MODEL" styleClass="section-label"/>
                <VBox spacing="12" styleClass="model-card">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="modelStatusDot" text="" styleClass="model-status, model-idle"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label fx:id="modelNameLabel"
                                   text="No model loaded"
                                   wrapText="true"
                                   styleClass="model-name"/>
                            <Label fx:id="modelDetailsLabel"
                                   text="Choose a DeepJ .dj checkpoint"
                                   wrapText="true"
                                   styleClass="model-details"/>
                        </VBox>
                    </HBox>
                    <Button fx:id="modelButton"
                            text="Choose file"
                            onAction="#onBrowseModel"
                            styleClass="load-model-button">
                        <graphic>
                            <SVGPath content="M2 5h5l2 2h7v8H2z"
                                     styleClass="button-icon"/>
                        </graphic>
                    </Button>
                </VBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="settingsButton"
                    text="Settings"
                    maxWidth="Infinity"
                    onAction="#onToggleSettings"
                    styleClass="sidebar-button">
                <graphic>
                    <SVGPath content="M2 4h14 M2 9h14 M2 14h14 M6 2v4 M12 7v4 M8 12v4"
                             styleClass="button-icon"/>
                </graphic>
            </Button>
            <Label fx:id="statusLabel" wrapText="true" styleClass="status-label"/>
        </VBox>
    </left>

    <center>
        <BorderPane styleClass="conversation-pane">
            <top>
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar">
                    <padding>
                        <Insets top="14" right="22" bottom="14" left="22"/>
                    </padding>
                    <Button fx:id="sidebarOpenButton"
                            id="sidebarOpenButton"
                            accessibleText="Show sidebar"
                            managed="false"
                            onAction="#onToggleSidebar"
                            styleClass="sidebar-toggle-button"
                            visible="false">
                        <graphic>
                            <SVGPath content="M2 3h14v12H2z M6 3v12"
                                     styleClass="button-icon"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Show sidebar"/>
                        </tooltip>
                    </Button>
                    <VBox spacing="1">
                        <Label text="DeepJ Chat" styleClass="top-title"/>
                        <Label text="Private and on-device" styleClass="top-caption"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Local" styleClass="local-badge"/>
                </HBox>
            </top>

            <center>
                <StackPane styleClass="conversation-stage">
                    <ScrollPane fx:id="scrollPane"
                                fitToWidth="true"
                                hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED"
                                styleClass="chat-scroll">
                        <content>
                            <VBox fx:id="messagesBox"
                                  alignment="TOP_CENTER"
                                  maxWidth="820"
                                  spacing="28"
                                  styleClass="messages-box">
                                <padding>
                                    <Insets top="34" right="28" bottom="34" left="28"/>
                                </padding>
                            </VBox>
                        </content>
                    </ScrollPane>

                    <VBox fx:id="welcomeBox"
                          alignment="CENTER"
                          maxWidth="520"
                          mouseTransparent="true"
                          spacing="12"
                          styleClass="welcome-box">
                        <Label text="D" styleClass="welcome-mark"/>
                        <Label text="How can DeepJ help?" styleClass="welcome-title"/>
                        <Label text="Load a Prism checkpoint, then start a conversation."
                               textAlignment="CENTER"
                               wrapText="true"
                               styleClass="welcome-copy"/>
                    </VBox>

                    <Region fx:id="settingsBackdrop"
                            managed="false"
                            visible="false"
                            styleClass="settings-backdrop"/>

                    <VBox fx:id="settingsPanel"
                          alignment="TOP_LEFT"
                          managed="false"
                          maxWidth="360"
                          minWidth="360"
                          spacing="20"
                          visible="false"
                          StackPane.alignment="TOP_RIGHT"
                          styleClass="settings-panel">
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="3">
                                <Label text="Settings" styleClass="settings-title"/>
                                <Label text="Personalise chat and generation"
                                       styleClass="settings-caption"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button accessibleText="Close settings"
                                    onAction="#onToggleSettings"
                                    styleClass="close-settings-button">
                                <graphic>
                                    <SVGPath content="M4 4l10 10 M14 4L4 14"
                                             styleClass="button-icon"/>
                                </graphic>
                                <tooltip>
                                    <Tooltip text="Close settings"/>
                                </tooltip>
                            </Button>
                        </HBox>

                        <Separator/>

                        <VBox spacing="10">
                            <Label text="APPEARANCE" styleClass="section-label"/>
                            <HBox spacing="6" styleClass="theme-selector">
                                <Button fx:id="lightThemeButton"
                                        text="Light"
                                        onAction="#onTheme"
                                        userData="LIGHT"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"
                                        styleClass="theme-button"/>
                                <Button fx:id="darkThemeButton"
                                        text="Dark"
                                        onAction="#onTheme"
                                        userData="DARK"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"
                                        styleClass="theme-button"/>
                                <Button fx:id="midnightThemeButton"
                                        text="Midnight"
                                        onAction="#onTheme"
                                        userData="MIDNIGHT"
                                        HBox.hgrow="ALWAYS"
                                        maxWidth="Infinity"
                                        styleClass="theme-button"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="12">
                            <VBox spacing="3">
                                <Label text="GENERATION" styleClass="section-label"/>
                                <Label text="Advanced controls for the next response"
                                       styleClass="settings-caption"/>
                            </VBox>
                            <HBox spacing="10">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Temperature" styleClass="field-label"/>
                                    <TextField fx:id="temperatureField" styleClass="settings-field"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Top-k" styleClass="field-label"/>
                                    <TextField fx:id="topKField" styleClass="settings-field"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="10">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Max tokens" styleClass="field-label"/>
                                    <TextField fx:id="maxTokensField" styleClass="settings-field"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Seed" styleClass="field-label"/>
                                    <TextField fx:id="seedField" styleClass="settings-field"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>
                </StackPane>
            </center>

            <bottom>
                <VBox alignment="CENTER" spacing="8" styleClass="composer-panel">
                    <HBox fx:id="typingIndicator"
                          alignment="CENTER_LEFT"
                          maxWidth="820"
                          spacing="8"
                          styleClass="typing-indicator">
                        <Label text="" styleClass="typing-dot"/>
                        <Label text="DeepJ is thinking" styleClass="typing-text"/>
                    </HBox>

                    <HBox alignment="BOTTOM_CENTER"
                          maxWidth="820"
                          spacing="10"
                          styleClass="composer-shell">
                        <TextArea fx:id="inputArea"
                                  HBox.hgrow="ALWAYS"
                                  onKeyPressed="#onInputKeyPressed"
                                  prefRowCount="2"
                                  promptText="Message DeepJ"
                                  wrapText="true"
                                  styleClass="chat-input"/>
                        <Button fx:id="sendButton"
                                text="↑"
                                onAction="#onSend"
                                styleClass="send-button"/>
                    </HBox>
                    <Label text="Enter to send · Shift + Enter for a new line"
                           styleClass="composer-caption"/>
                </VBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
